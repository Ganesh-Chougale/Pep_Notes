    <external-files-path
        name="external_files"
        path="Documents/" />
    
    <!-- External storage for Downloads -->
    <external-path
        name="external_storage"
        path="Download/" />
    
    <!-- Cache directory -->
    <cache-path
        name="cache"
        path="/" />
</paths>
